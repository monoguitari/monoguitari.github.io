---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Catalog — Monoguitari">
  <div class="catalog-header">
    <h1 class="catalog-title">Catalog</h1>
    <p class="catalog-subtitle">Monoguitari · Est. 2022</p>
    <div class="rule" style="margin-bottom: 64px;"></div>
  </div>

  <div class="section" style="padding-top: 0;">
    <div class="catalog-grid">

      <!-- MGT-001 -->
      <a href="#" class="card">
        <div class="card-art" style="background: var(--red);">
          <span class="card-mark">M</span>
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.18" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <circle cx="320" cy="80" r="200" fill="none" stroke="#f5f0e8" stroke-width="60"/>
            <circle cx="80" cy="320" r="140" fill="none" stroke="#f5f0e8" stroke-width="40"/>
          </svg>
          <div class="card-art-inner">
            <h3 class="card-title">Assortment<br />Planning AI</h3>
          </div>
          <div class="card-hover-desc">
            <p>FastAPI + GPT-4o pipeline reducing token usage 1,200× and saving 14,800 hours across large-scale plans.</p>
            <span class="arrow">↗</span>
          </div>
        </div>
        <div class="card-meta">
          <p class="card-catalog">MGT-001</p>
          <p class="card-name">Assortment Planning AI</p>
          <p class="card-credits">Produced using — FastAPI · React · GPT-4o · CosmosDB<br />Walmart Global Tech, 2025</p>
        </div>
      </a>

      <!-- MGT-002 -->
      <a href="#" class="card">
        <div class="card-art" style="background: var(--blue);">
          <span class="card-mark">M</span>
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.15" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <rect x="50" y="50" width="300" height="300" fill="none" stroke="#f5f0e8" stroke-width="50"/>
            <rect x="130" y="130" width="140" height="140" fill="#f5f0e8" opacity="0.3"/>
          </svg>
          <div class="card-art-inner">
            <h3 class="card-title">Genomic Age<br />Prediction</h3>
          </div>
          <div class="card-hover-desc">
            <p>scBasset CNN adapted with TensorFlow + R to predict cell age from single-cell ATAC-seq embeddings.</p>
            <span class="arrow">↗</span>
          </div>
        </div>
        <div class="card-meta">
          <p class="card-catalog">MGT-002</p>
          <p class="card-name">Genomic Age Prediction</p>
          <p class="card-credits">Produced using — TensorFlow · Python · R · scBasset<br />Singh Lab, Brown University, 2025</p>
        </div>
      </a>

      <!-- MGT-003 -->
      <a href="#" class="card">
        <div class="card-art" style="background: var(--olive);">
          <span class="card-mark">M</span>
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.15" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <line x1="0" y1="200" x2="400" y2="200" stroke="#f5f0e8" stroke-width="60"/>
            <line x1="200" y1="0" x2="200" y2="400" stroke="#f5f0e8" stroke-width="60"/>
            <circle cx="200" cy="200" r="80" fill="#f5f0e8" opacity="0.2"/>
          </svg>
          <div class="card-art-inner">
            <h3 class="card-title">DL for<br />Interpretability</h3>
          </div>
          <div class="card-hover-desc">
            <p>Control vectors + Double Machine Learning to evaluate interpretability of deep learning models in social science.</p>
            <span class="arrow">↗</span>
          </div>
        </div>
        <div class="card-meta">
          <p class="card-catalog">MGT-003</p>
          <p class="card-name">DL for Interpretability</p>
          <p class="card-credits">Produced using — TensorFlow · Python · Causal Inference<br />Brown University, 2024</p>
        </div>
      </a>

      <!-- MGT-004 -->
      <a href="#" class="card">
        <div class="card-art" style="background: #3a2a1a;">
          <span class="card-mark">M</span>
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.2" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <rect x="60" y="100" width="280" height="30" fill="#f5f0e8"/>
            <rect x="60" y="150" width="220" height="20" fill="#f5f0e8" opacity="0.6"/>
            <rect x="60" y="190" width="260" height="20" fill="#f5f0e8" opacity="0.5"/>
            <rect x="60" y="230" width="180" height="20" fill="#f5f0e8" opacity="0.4"/>
            <rect x="60" y="270" width="240" height="20" fill="#f5f0e8" opacity="0.3"/>
          </svg>
          <div class="card-art-inner">
            <h3 class="card-title">Census<br />OCR Pipeline</h3>
          </div>
          <div class="card-hover-desc">
            <p>AI-assisted OCR pipeline to digitize historical U.S. Census records for socioeconomic research accessibility.</p>
            <span class="arrow">↗</span>
          </div>
        </div>
        <div class="card-meta">
          <p class="card-catalog">MGT-004</p>
          <p class="card-name">Census OCR Pipeline</p>
          <p class="card-credits">Produced using — Python · ML · OCR · Text Recognition<br />Anna Aizer Lab, Brown University, 2025</p>
        </div>
      </a>

      <!-- MGT-005 -->
      <a href="#" class="card">
        <div class="card-art" style="background: #1a2a2a;">
          <span class="card-mark">M</span>
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.18" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <circle cx="200" cy="200" r="160" fill="none" stroke="#f5f0e8" stroke-width="3"/>
            <circle cx="200" cy="200" r="110" fill="none" stroke="#f5f0e8" stroke-width="2"/>
            <circle cx="200" cy="200" r="60" fill="none" stroke="#f5f0e8" stroke-width="2"/>
            <line x1="40" y1="200" x2="360" y2="200" stroke="#f5f0e8" stroke-width="1"/>
            <line x1="200" y1="40" x2="200" y2="360" stroke="#f5f0e8" stroke-width="1"/>
          </svg>
          <div class="card-art-inner">
            <h3 class="card-title">Serre Lab<br />Website</h3>
          </div>
          <div class="card-hover-desc">
            <p>Redesigned neuro-AI research lab website using Figma and React, with science communication content.</p>
            <span class="arrow">↗</span>
          </div>
        </div>
        <div class="card-meta">
          <p class="card-catalog">MGT-005</p>
          <p class="card-name">Serre Lab Website</p>
          <p class="card-credits">Produced using — React · Figma · CSS<br />Serre Lab, Brown University, 2024–2025</p>
        </div>
      </a>

      <!-- MGT-006 -->
      <a href="#" class="card">
        <div class="card-art" style="background: #1e1a2e;">
          <span class="card-mark">M</span>
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.18" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <rect x="80" y="80" width="240" height="240" fill="none" stroke="#f5f0e8" stroke-width="3"/>
            <rect x="120" y="120" width="160" height="160" fill="none" stroke="#f5f0e8" stroke-width="2"/>
            <rect x="160" y="160" width="80" height="80" fill="#f5f0e8" opacity="0.15"/>
            <line x1="80" y1="80" x2="320" y2="320" stroke="#f5f0e8" stroke-width="1"/>
            <line x1="320" y1="80" x2="80" y2="320" stroke="#f5f0e8" stroke-width="1"/>
          </svg>
          <div class="card-art-inner">
            <h3 class="card-title">HPC GPU<br />Acceleration</h3>
          </div>
          <div class="card-hover-desc">
            <p>Deployed NVIDIA Parabricks on HPC cluster via Docker, reducing genomics pipeline runtime from 3h to 30min.</p>
            <span class="arrow">↗</span>
          </div>
        </div>
        <div class="card-meta">
          <p class="card-catalog">MGT-006</p>
          <p class="card-name">HPC GPU Acceleration</p>
          <p class="card-credits">Produced using — Docker · NVIDIA Parabricks · HPC<br />CCV, Brown University, 2024</p>
        </div>
      </a>

    </div>
  </div>
</BaseLayout>
