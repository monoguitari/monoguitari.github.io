---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="B-Sides — Monoguitari">
  <div class="blog-header">
    <h1 class="blog-title">B-Sides</h1>
    <p class="blog-subtitle">Monoguitari · Rarities &amp; Notes</p>
    <div class="rule" style="margin-bottom: 0;"></div>
  </div>

  <div class="blog-coming-soon">
    <p>Content coming soon.</p>
  </div>
</BaseLayout>

<style>
  .blog-coming-soon {
    padding: 80px 0;
    color: var(--muted);
    font-size: 14px;
    letter-spacing: 0.06em;
    text-align: center;
  }
</style>
