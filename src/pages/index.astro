---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Jesus Rodriguez — Monoguitari">
  <!-- Hero -->
  <div class="hero">
    <div class="hero-left">
      <p class="hero-eyebrow">CS @ Brown · Full Stack &amp; AI/ML</p>
      <h1 class="hero-name">Jesus<br />Rodriguez</h1>
      <p class="hero-tagline">
        <span>Building intelligent systems at the intersection of</span><br />
        software engineering and machine learning.
      </p>
      <div class="hero-actions">
        <a href="/projects" class="btn btn-primary">View Catalog →</a>
        <a href="/resume.pdf" target="_blank" class="btn btn-outline">Résumé ↗</a>
      </div>
    </div>

    <div class="hero-right">
      <div class="vinyl-glow"></div>
      <div class="vinyl-wrapper">
        <svg class="vinyl-record" viewBox="0 0 380 380" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="190" cy="190" r="188" fill="#0f0f0f" stroke="#1a1a1a" stroke-width="1"/>
          <circle cx="190" cy="190" r="182" fill="none" stroke="#1c1c1c" stroke-width="0.6"/>
          <circle cx="190" cy="190" r="176" fill="none" stroke="#181818" stroke-width="0.6"/>
          <circle cx="190" cy="190" r="170" fill="none" stroke="#1c1c1c" stroke-width="0.5"/>
          <circle cx="190" cy="190" r="164" fill="none" stroke="#181818" stroke-width="0.5"/>
          <circle cx="190" cy="190" r="158" fill="none" stroke="#1c1c1c" stroke-width="0.5"/>
          <circle cx="190" cy="190" r="152" fill="none" stroke="#181818" stroke-width="0.4"/>
          <circle cx="190" cy="190" r="146" fill="none" stroke="#1c1c1c" stroke-width="0.4"/>
          <circle cx="190" cy="190" r="140" fill="none" stroke="#181818" stroke-width="0.4"/>
          <circle cx="190" cy="190" r="134" fill="none" stroke="#1c1c1c" stroke-width="0.4"/>
          <circle cx="190" cy="190" r="128" fill="none" stroke="#181818" stroke-width="0.3"/>
          <circle cx="190" cy="190" r="122" fill="none" stroke="#1c1c1c" stroke-width="0.3"/>
          <circle cx="190" cy="190" r="116" fill="none" stroke="#181818" stroke-width="0.3"/>
          <circle cx="190" cy="190" r="110" fill="none" stroke="#1c1c1c" stroke-width="0.3"/>
          <circle cx="190" cy="190" r="104" fill="none" stroke="#181818" stroke-width="0.3"/>
          <circle cx="190" cy="190" r="96" fill="none" stroke="#222" stroke-width="1.2"/>
          <circle cx="190" cy="190" r="92" fill="#111111"/>
          <circle cx="190" cy="190" r="91" fill="none" stroke="#c9a84c" stroke-width="0.4" opacity="0.5"/>
          <circle cx="190" cy="190" r="85" fill="none" stroke="#c9a84c" stroke-width="0.3" opacity="0.25"/>
          <text x="190" y="178" text-anchor="middle" font-family="'Space Grotesk', sans-serif" font-size="9" font-weight="600" letter-spacing="4" fill="#c9a84c" opacity="0.8">MONOGUITARI</text>
          <text x="190" y="192" text-anchor="middle" font-family="'Space Grotesk', sans-serif" font-size="6" font-weight="400" letter-spacing="2" fill="#f5f0e8" opacity="0.35">PROVIDENCE · RI</text>
          <text x="190" y="205" text-anchor="middle" font-family="'Space Grotesk', sans-serif" font-size="7" font-weight="500" letter-spacing="1" fill="#f5f0e8" opacity="0.5">2026</text>
          <circle cx="190" cy="190" r="5" fill="#0a0a0a"/>
          <circle cx="190" cy="190" r="4.5" stroke="#c9a84c" stroke-width="0.5" fill="none" opacity="0.4"/>
          <ellipse cx="150" cy="145" rx="28" ry="12" fill="white" opacity="0.025" transform="rotate(-30 150 145)"/>
        </svg>

        <svg class="tonearm-wrapper" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="140" cy="18" r="8" fill="#1a1a1a" stroke="#c9a84c" stroke-width="0.6" opacity="0.7"/>
          <circle cx="140" cy="18" r="3" fill="#c9a84c" opacity="0.5"/>
          <line x1="140" y1="18" x2="58" y2="108" stroke="#d0c9bb" stroke-width="2" stroke-linecap="round"/>
          <line x1="58" y1="108" x2="44" y2="120" stroke="#d0c9bb" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="44" cy="122" r="2.5" fill="#c9a84c" opacity="0.9"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Ruled line -->
  <div style="padding: 0 60px; max-width: var(--max); margin: 0 auto 64px;">
    <div class="rule"></div>
  </div>

  <!-- Featured section -->
  <div class="section" style="padding-top: 0;">
    <div class="featured-header">
      <div>
        <p class="label-small" style="margin-bottom: 10px;">Featured Releases</p>
        <h2 style="font-size: 28px; font-weight: 700; letter-spacing: -0.02em;">Catalog</h2>
      </div>
      <a href="/projects" class="link-arrow">View full catalog →</a>
    </div>

    <div class="featured-grid">
      <!-- MGT-001 -->
      <a href="/projects" class="card">
        <div class="card-art" style="background: var(--red);">
          <span class="card-mark">M</span>
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.18" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <circle cx="320" cy="80" r="200" fill="none" stroke="#f5f0e8" stroke-width="60"/>
            <circle cx="80" cy="320" r="140" fill="none" stroke="#f5f0e8" stroke-width="40"/>
          </svg>
          <div class="card-art-inner">
            <h3 class="card-title">Assortment<br />Planning AI</h3>
          </div>
          <div class="card-hover-desc">
            <p>FastAPI + GPT-4o pipeline reducing token usage 1,200× for real-time AI summaries at Walmart Global Tech.</p>
            <span class="arrow">↗</span>
          </div>
        </div>
        <div class="card-meta">
          <p class="card-catalog">MGT-001</p>
          <p class="card-name">Assortment Planning AI</p>
          <p class="card-credits">Produced using — FastAPI · React · GPT-4o · CosmosDB<br />Walmart Global Tech, 2025</p>
        </div>
      </a>

      <!-- MGT-002 -->
      <a href="/projects" class="card">
        <div class="card-art" style="background: var(--blue);">
          <span class="card-mark">M</span>
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.15" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <rect x="50" y="50" width="300" height="300" fill="none" stroke="#f5f0e8" stroke-width="50"/>
            <rect x="130" y="130" width="140" height="140" fill="#f5f0e8" opacity="0.3"/>
          </svg>
          <div class="card-art-inner">
            <h3 class="card-title">Genomic Age<br />Prediction</h3>
          </div>
          <div class="card-hover-desc">
            <p>Adapted scBasset CNN with TensorFlow to predict cell age from single-cell ATAC-seq embeddings.</p>
            <span class="arrow">↗</span>
          </div>
        </div>
        <div class="card-meta">
          <p class="card-catalog">MGT-002</p>
          <p class="card-name">Genomic Age Prediction</p>
          <p class="card-credits">Produced using — TensorFlow · Python · R · scBasset<br />Singh Lab, Brown University, 2025</p>
        </div>
      </a>

      <!-- MGT-003 -->
      <a href="/projects" class="card">
        <div class="card-art" style="background: var(--olive);">
          <span class="card-mark">M</span>
          <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.15" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <line x1="0" y1="200" x2="400" y2="200" stroke="#f5f0e8" stroke-width="60"/>
            <line x1="200" y1="0" x2="200" y2="400" stroke="#f5f0e8" stroke-width="60"/>
            <circle cx="200" cy="200" r="80" fill="#f5f0e8" opacity="0.2"/>
          </svg>
          <div class="card-art-inner">
            <h3 class="card-title">DL for<br />Interpretability</h3>
          </div>
          <div class="card-hover-desc">
            <p>Control vectors + Double Machine Learning to evaluate deep learning interpretability in social science.</p>
            <span class="arrow">↗</span>
          </div>
        </div>
        <div class="card-meta">
          <p class="card-catalog">MGT-003</p>
          <p class="card-name">DL for Interpretability</p>
          <p class="card-credits">Produced using — TensorFlow · Python · Causal Inference<br />Brown University, 2024</p>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>
