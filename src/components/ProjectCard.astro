---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  href?: string;
}

const { project, href } = Astro.props;

// FNV-1a: better avalanche than polynomial hash, so similar IDs (MGT-001, MGT-002…) spread across the palette
function hashStr(str: string): number {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

const COLORS = [
  'var(--red)',
  'var(--blue)',
  'var(--olive)',
  '#3a2a1a',
  '#1a2a2a',
  '#1e1a2e',
  '#2a1a2e',
  '#1a2e1a',
  '#2e1a1a',
  '#1a1e2e',
];

const PATTERNS: { svg: string; opacity: number }[] = [
  {
    svg: `<circle cx="320" cy="80" r="200" fill="none" stroke="#f5f0e8" stroke-width="60"/>
          <circle cx="80" cy="320" r="140" fill="none" stroke="#f5f0e8" stroke-width="40"/>`,
    opacity: 0.18,
  },
  {
    svg: `<rect x="50" y="50" width="300" height="300" fill="none" stroke="#f5f0e8" stroke-width="50"/>
          <rect x="130" y="130" width="140" height="140" fill="#f5f0e8" opacity="0.3"/>`,
    opacity: 0.15,
  },
  {
    svg: `<line x1="0" y1="200" x2="400" y2="200" stroke="#f5f0e8" stroke-width="60"/>
          <line x1="200" y1="0" x2="200" y2="400" stroke="#f5f0e8" stroke-width="60"/>
          <circle cx="200" cy="200" r="80" fill="#f5f0e8" opacity="0.2"/>`,
    opacity: 0.15,
  },
  {
    svg: `<rect x="60" y="100" width="280" height="30" fill="#f5f0e8"/>
          <rect x="60" y="150" width="220" height="20" fill="#f5f0e8" opacity="0.6"/>
          <rect x="60" y="190" width="260" height="20" fill="#f5f0e8" opacity="0.5"/>
          <rect x="60" y="230" width="180" height="20" fill="#f5f0e8" opacity="0.4"/>
          <rect x="60" y="270" width="240" height="20" fill="#f5f0e8" opacity="0.3"/>`,
    opacity: 0.2,
  },
  {
    svg: `<circle cx="200" cy="200" r="160" fill="none" stroke="#f5f0e8" stroke-width="3"/>
          <circle cx="200" cy="200" r="110" fill="none" stroke="#f5f0e8" stroke-width="2"/>
          <circle cx="200" cy="200" r="60" fill="none" stroke="#f5f0e8" stroke-width="2"/>
          <line x1="40" y1="200" x2="360" y2="200" stroke="#f5f0e8" stroke-width="1"/>
          <line x1="200" y1="40" x2="200" y2="360" stroke="#f5f0e8" stroke-width="1"/>`,
    opacity: 0.18,
  },
  {
    svg: `<rect x="80" y="80" width="240" height="240" fill="none" stroke="#f5f0e8" stroke-width="3"/>
          <rect x="120" y="120" width="160" height="160" fill="none" stroke="#f5f0e8" stroke-width="2"/>
          <rect x="160" y="160" width="80" height="80" fill="#f5f0e8" opacity="0.15"/>
          <line x1="80" y1="80" x2="320" y2="320" stroke="#f5f0e8" stroke-width="1"/>
          <line x1="320" y1="80" x2="80" y2="320" stroke="#f5f0e8" stroke-width="1"/>`,
    opacity: 0.18,
  },
  {
    svg: `<polygon points="200,40 370,340 30,340" fill="none" stroke="#f5f0e8" stroke-width="3"/>
          <polygon points="200,110 310,300 90,300" fill="#f5f0e8" opacity="0.1"/>
          <circle cx="200" cy="220" r="30" fill="#f5f0e8" opacity="0.2"/>`,
    opacity: 0.18,
  },
  {
    svg: `<line x1="-60" y1="100" x2="460" y2="100" stroke="#f5f0e8" stroke-width="70"/>
          <line x1="-60" y1="250" x2="460" y2="250" stroke="#f5f0e8" stroke-width="40" opacity="0.5"/>
          <line x1="-60" y1="360" x2="460" y2="360" stroke="#f5f0e8" stroke-width="20" opacity="0.3"/>`,
    opacity: 0.16,
  },
  {
    svg: `<circle cx="200" cy="200" r="170" fill="none" stroke="#f5f0e8" stroke-width="80" opacity="0.5"/>
          <circle cx="200" cy="200" r="80" fill="#f5f0e8" opacity="0.12"/>`,
    opacity: 0.2,
  },
  {
    svg: `<line x1="0" y1="0" x2="400" y2="400" stroke="#f5f0e8" stroke-width="60"/>
          <line x1="400" y1="0" x2="0" y2="400" stroke="#f5f0e8" stroke-width="60"/>
          <rect x="150" y="150" width="100" height="100" fill="#f5f0e8" opacity="0.2"/>`,
    opacity: 0.15,
  },
];

const h = hashStr(project.id);
// separate seed so color and pattern don't correlate (single hash bits cluster)
const h2 = hashStr(project.id + '|pattern');
const bgColor = project.color ?? COLORS[h % COLORS.length];
const pattern = PATTERNS[h2 % PATTERNS.length];
const link = href ?? project.href ?? '#';
const techStr = project.tech.join(' · ');
---

<a href={link} class="card">
  <div class="card-art" style={`background: ${bgColor};`}>
    <span class="card-mark">M</span>
    {project.image ? (
      <img
        src={project.image}
        alt={project.title}
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
      />
    ) : (
      <svg
        style={`position:absolute;inset:0;width:100%;height:100%;opacity:${pattern.opacity}`}
        viewBox="0 0 400 400"
        preserveAspectRatio="xMidYMid slice"
        set:html={pattern.svg}
      />
    )}
    <div class="card-art-inner">
      <h3 class="card-title">{project.title}</h3>
    </div>
    <div class="card-hover-desc">
      <p>{project.description}</p>
      <span class="arrow">↗</span>
    </div>
  </div>
  <div class="card-meta">
    <p class="card-catalog">{project.id}</p>
    <p class="card-name">{project.title}</p>
    <p class="card-credits">Produced using — {techStr}<br />{project.org}, {project.year}</p>
  </div>
</a>
